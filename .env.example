# Copy to .env and adjust. Every value has a working default in docker-compose.yml.

# Database
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DB_POOL_SIZE=60

# Backend
ASPNETCORE_ENVIRONMENT=Production
# Default payment window for classes created WITHOUT an explicit duration.
# The duration an admin configures on a class always takes precedence.
HOLD_DURATION_SECONDS=600
EXPIRATION_INTERVAL_SECONDS=5
ADMISSION_FEE=5000
JWT_KEY=change-this-development-jwt-signing-key-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
# true = create four demo classes when the database has none
SEED_DEMO_DATA=true

# Frontend (served by nginx on :5173). The browser calls /api/*, which nginx proxies to the backend,
# so no API URL is baked into the image. Only used for `npm run dev` against another backend:
# VITE_API_BASE_URL=http://localhost:8080
