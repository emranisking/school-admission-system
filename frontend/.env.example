# Base URL the browser uses to reach the backend API.
# Leave as "/api" when nginx proxies /api/ to the backend (the default docker setup).
# Set to an absolute URL only when the frontend is served without the nginx proxy,
# e.g. "http://192.168.1.10:8080".
VITE_API_BASE_URL=/api

# Dev-server port for `npm run dev` only. Ignored in production (nginx handles the port).
VITE_DEV_PORT=80